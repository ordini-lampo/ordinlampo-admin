// ================================================================
// src/middleware/rateLimit.ts — RATE LIMITING OBBLIGATORIO
// ================================================================
// CONFORME A SMP4 §12.1 — Rate limiting per tutti gli endpoint
// ================================================================

import rateLimit, { RateLimitRequestHandler } from 'express-rate-limit';
import { Request } from 'express';

const rateLimitMessage = {
  error: {
    code: 'RATE_LIMITED',
    message: 'Troppe richieste. Riprova più tardi.',
  },
};

// ================================================================
// GLOBAL LIMITER — Tutti gli endpoint
// ================================================================
export const globalLimiter: RateLimitRequestHandler = rateLimit({
  windowMs: 60 * 1000,
  max: 60,
  message: rateLimitMessage,
  standardHeaders: true,
  legacyHeaders: false,
  skip: (req: Request) => req.path === '/health' || req.path === '/health/live',
  keyGenerator: (req: Request) => {
    return (req.headers['x-forwarded-for'] as string)?.split(',')[0]?.trim() || 
           req.ip || 'unknown';
  },
});

// ================================================================
// AUTH LIMITER — Endpoint autenticati
// ================================================================
export const authLimiter: RateLimitRequestHandler = rateLimit({
  windowMs: 60 * 1000,
  max: 300,
  message: rateLimitMessage,
  standardHeaders: true,
  legacyHeaders: false,
  keyGenerator: (req: Request) => {
    const user = (req as any).user;
    if (user?.id) return `user:${user.id}`;
    return (req.headers['x-forwarded-for'] as string)?.split(',')[0]?.trim() || 
           req.ip || 'unknown';
  },
});

// ================================================================
// CRITICAL LIMITER — Ordini, pagamenti
// ================================================================
export const criticalLimiter: RateLimitRequestHandler = rateLimit({
  windowMs: 60 * 1000,
  max: 10,
  message: {
    error: {
      code: 'RATE_LIMITED',
      message: 'Troppe richieste per questa azione. Attendi un minuto.',
    },
  },
  standardHeaders: true,
  legacyHeaders: false,
  keyGenerator: (req: Request) => {
    const user = (req as any).user;
    const userId = user?.id || req.ip || 'unknown';
    return `critical:${userId}:${req.method}:${req.baseUrl}`;
  },
});

// ================================================================
// LOGIN LIMITER — Protezione brute force
// ================================================================
export const loginLimiter: RateLimitRequestHandler = rateLimit({
  windowMs: 15 * 60 * 1000,
  max: 5,
  message: {
    error: {
      code: 'RATE_LIMITED',
      message: 'Troppi tentativi di login. Riprova tra 15 minuti.',
    },
  },
  standardHeaders: true,
  legacyHeaders: false,
  keyGenerator: (req: Request) => `login:${req.ip || 'unknown'}`,
  skipSuccessfulRequests: true,
});
