# SEZIONE 9: CIRCUIT BREAKER STRIPE — src/services/paymentService.ts

```typescript
// ================================================================
// src/services/paymentService.ts — PAGAMENTI CON CIRCUIT BREAKER
// ================================================================
// CONFORME A SMP4 §12.2 — Circuit breaker OBBLIGATORIO su Stripe
// ================================================================

import Stripe from 'stripe';
import CircuitBreaker from 'opossum';
import * as Sentry from '@sentry/node';
import { AppError } from '../middleware/errorHandler';

// ================================================================
// STRIPE CLIENT
// ================================================================
const stripe = new Stripe(process.env.STRIPE_SECRET_KEY!, {
  apiVersion: '2023-10-16',
  timeout: 10000,
  maxNetworkRetries: 2,
});

// ================================================================
// CIRCUIT BREAKER OPTIONS (SMP4 §12.2)
// ================================================================
const breakerOptions: CircuitBreaker.Options = {
  timeout: 10000,
  errorThresholdPercentage: 50,
  resetTimeout: 60000,
  volumeThreshold: 5,
  rollingCountTimeout: 30000,
};

// ================================================================
// CREATE PAYMENT INTENT
// ================================================================
const createPaymentIntentBreaker = new CircuitBreaker(
  async (params: Stripe.PaymentIntentCreateParams) => stripe.paymentIntents.create(params),
  breakerOptions
);

createPaymentIntentBreaker.on('open', () => {
  console.error('⚠️ CIRCUIT BREAKER STRIPE: APERTO');
  Sentry.captureMessage('Stripe circuit breaker opened', { level: 'warning' });
});

createPaymentIntentBreaker.on('halfOpen', () => {
  console.log('Circuit breaker Stripe: HALF-OPEN');
});

createPaymentIntentBreaker.on('close', () => {
  console.log('✅ Circuit breaker Stripe: CHIUSO');
});

// ================================================================
// EXPORTED FUNCTIONS
// ================================================================
export async function createPaymentIntent(
  amount: number,
  currency: string = 'eur',
  metadata?: Record<string, string>
): Promise<Stripe.PaymentIntent> {
  try {
    return await createPaymentIntentBreaker.fire({
      amount,
      currency,
      metadata,
      automatic_payment_methods: { enabled: true },
    });
  } catch (error) {
    if ((error as Error).message?.includes('Breaker is open')) {
      throw AppError.serviceUnavailable('Servizio pagamenti temporaneamente non disponibile');
    }
    throw error;
  }
}

export async function getPaymentIntent(paymentIntentId: string): Promise<Stripe.PaymentIntent> {
  return stripe.paymentIntents.retrieve(paymentIntentId);
}

export function getStripeCircuitStatus(): { isOpen: boolean; stats: CircuitBreaker.Stats } {
  return {
    isOpen: createPaymentIntentBreaker.opened,
    stats: createPaymentIntentBreaker.stats,
  };
}
