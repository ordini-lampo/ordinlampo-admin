import { Pool, PoolClient, QueryResultRow } from 'pg';

// ================================================================
// POOL CONFIGURATION
// ================================================================
export const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  
  // OBBLIGATORIO: Limiti connessioni
  max: 20,
  min: 2,
  
