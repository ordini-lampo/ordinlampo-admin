  public readonly statusCode: number;
  public readonly code: ErrorCode;
  public readonly isOperational: boolean;

  constructor(statusCode: number, code: ErrorCode, message: string, isOperational = true) {
    super(message);
    this.statusCode = statusCode;
    this.code = code;
    this.isOperational = isOperational;
    Object.setPrototypeOf(this, AppError.prototype);
  }

  static badRequest(message: string): AppError {
    return new AppError(400, 'BAD_REQUEST', message);
  }

  static unauthorized(message = 'Non autorizzato'): AppError {
    return new AppError(401, 'UNAUTHORIZED', message);
  }

  static forbidden(message = 'Accesso negato'): AppError {
    return new AppError(403, 'FORBIDDEN', message);
  }

  static notFound(message = 'Risorsa non trovata'): AppError {
    return new AppError(404, 'NOT_FOUND', message);
  }

  static conflict(message: string): AppError {
    return new AppError(409, 'CONFLICT', message);
  }

  static internal(message = 'Errore interno'): AppError {
    return new AppError(500, 'INTERNAL_ERROR', message, false);
  }

  static serviceUnavailable(message = 'Servizio temporaneamente non disponibile'): AppError {
    return new AppError(503, 'SERVICE_UNAVAILABLE', message);
  }
}

// ================================================================
// ERROR HANDLER MIDDLEWARE
// ================================================================
export const errorHandler: ErrorRequestHandler = (
  err: Error | AppError,
  req: Request,
  res: Response,
  _next: NextFunction
): void => {
  const requestId = req.headers['x-request-id'] as string;
  
  // 1. LOG INTERNO COMPLETO
  console.error({
    timestamp: new Date().toISOString(),
    requestId,
    error: {
      name: err.name,
      message: err.message,
      stack: err.stack,
      ...(err instanceof AppError && { 
        code: err.code, 
        statusCode: err.statusCode,
      }),
    },
    request: {
      method: req.method,
      path: req.path,
      ip: req.ip,
    },
    user: (req as any).user?.id || null,
  });

  // 2. SENTRY
  if (!(err instanceof AppError) || !err.isOperational) {
    Sentry.captureException(err, {
      extra: { requestId, path: req.path, method: req.method },
    });
  }

  // 3. RISPOSTA SANITIZZATA — MAI stack trace
  if (err instanceof AppError) {
    res.status(err.statusCode).json({
      error: { code: err.code, message: err.message, requestId },
    });
    return;
  }

  // Errore generico
  res.status(500).json({
    error: {
      code: 'INTERNAL_ERROR',
      message: 'Si è verificato un errore interno. Riprova più tardi.',
      requestId,
    },
  });
};
