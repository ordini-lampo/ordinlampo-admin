RETURNS text
LANGUAGE sql
STABLE
AS $$
  SELECT NULLIF(current_setting('app.role', true), '')
$$;

-- Helper: bypass per superadmin (default-deny se role non settato)
CREATE OR REPLACE FUNCTION is_superadmin()
RETURNS boolean
LANGUAGE sql
STABLE
AS $$
  SELECT COALESCE(current_global_role() = 'superadmin', false)
$$;

-- =============================================================
-- RLS: ENABLE
-- =============================================================

